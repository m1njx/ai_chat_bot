# Gemini API Key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Naver API (https://developers.naver.com/)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Serper API (https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# 기상청 단기예보 (선택) - 공공데이터포털 https://www.data.go.kr/
# '단기예보 조회서비스(VilageFcstInfoService_2.0)' 신청 후 받은 '디코딩된 일반 인증키'.
# (인코딩된 키를 넣으면 requests가 이중 인코딩하여 인증에 실패한다)
KMA_API_KEY=your_kma_service_key_here

# 공개 배포 시 필수 (선택). 값을 설정하면 비밀번호 입력 게이트가 켜진다.
# 비워두면 로컬 단독 사용 모드로 동작한다.
APP_PASSWORD=

# OpenAI (선택) - Gemini 실패 시 자동 전환용 예비 제공자
# ※ OpenAI API는 선불 크레딧이 필요합니다. 크레딧이 0이면 429로 실패합니다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini        # 비우면 사용 가능한 저가 모델을 자동 선택
 
# LM Studio (선택) - 로컬 LLM. 무료이고 인터넷이 필요 없다.
# LM Studio 앱 > Developer 탭 > Status를 Running으로 켜고 모델을 로드할 것.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=                # 비우면 로드된 첫 번째 모델 사용

# 제공자 시도 순서 (기본: gemini,lmstudio,openai)
# LLM_ORDER=gemini,lmstudio,openai

# ── FastAPI 백엔드 (api.py) ──
# 프론트엔드 주소를 쉼표로 구분해 넣는다. 여기 없는 출처의 요청은 브라우저가 막는다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로그인 토큰 서명 키. 비우면 프로세스마다 새로 생성되어 재시작 시 로그인이 풀린다.
SECRET_KEY=
# 세션 토큰 유효 시간(초). 기본값: 86400 (24시간)
SESSION_TTL_SECONDS=86400
# ── 배포 및 지속성 저장소 설정 (Phase 8) ──
# 실행 환경 구분 (development / production). production 설정 시 APP_PASSWORD 및 SECRET_KEY 누락 시 fail-fast 적용
ENV=development
# 지속성 저장소 마운트 경로 (예: Render Persistent Disk 사용 시 /var/data). 비워두면 로컬 프로젝트 루트 사용
APP_DATA_DIR=

# 리버스 프록시(Render 등) 환경에서 X-Forwarded-For 신뢰 여부 (기본: false)
TRUST_PROXY_HEADERS=false

# ── RAG 검색 및 컨텍스트 제어 (core.py) ──
# 검색 후 프롬프트에 주입할 최대 문서 수 (기본: 5, 허용 범위: 1~20)
RAG_TOP_K=5
# 코사인 유사도 기반 최소 관련성 임계값 (기본: 0.58, 허용 범위: 0.0~1.0)
RAG_MIN_SIMILARITY=0.58
# RAG <지식> 블록 전체 최대 문자 수 예산 (기본: 3000, 허용 범위: 200~20000)
RAG_MAX_CONTEXT_CHARS=3000

# ── 지식 파일 업로드 및 청킹 설정 (core.py) ──
# 업로드 허용 최대 파일 크기 바이트 (기본: 20971520 [20MB])
# MAX_UPLOAD_BYTES=20971520
# 문서 청크 분할 목표 글자 수 (기본: 1000, 허용 범위: 200~3000)
# CHUNK_SIZE=1000
# 청크 간 겹침 글자 수 (기본: 150, 허용 범위: 0~500)
# CHUNK_OVERLAP=150


