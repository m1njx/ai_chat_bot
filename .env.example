# Gemini API Key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Naver API (https://developers.naver.com/)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Serper API (https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# 기상청 단기예보 (선택) - 공공데이터포털 https://www.data.go.kr/
# '단기예보 조회서비스(VilageFcstInfoService_2.0)' 신청 후 받은 '디코딩된 일반 인증키'.
# (인코딩된 키를 넣으면 requests가 이중 인코딩하여 인증에 실패한다)
KMA_API_KEY=your_kma_service_key_here

# 공개 배포 시 필수 (선택). 값을 설정하면:
#   1) 비밀번호 입력 게이트가 켜지고
#   2) 대화 기록이 브라우저 세션별로 분리된다.
# 비워두면 로컬 단독 사용 모드로 동작한다.
APP_PASSWORD=

# OpenAI (선택) - Gemini 실패 시 자동 전환용 예비 제공자
# ※ OpenAI API는 선불 크레딧이 필요합니다. 크레딧이 0이면 429로 실패합니다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini        # 비우면 사용 가능한 저가 모델을 자동 선택

# LM Studio (선택) - 로컬 LLM. 무료이고 인터넷이 필요 없다.
# LM Studio 앱 > Developer 탭 > Status를 Running으로 켜고 모델을 로드할 것.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=                # 비우면 로드된 첫 번째 모델 사용

# 제공자 시도 순서 (기본: gemini,lmstudio,openai)
# LLM_ORDER=gemini,lmstudio,openai

# ── FastAPI 백엔드 (api.py) ──
# 프론트엔드 주소를 쉼표로 구분해 넣는다. 여기 없는 출처의 요청은 브라우저가 막는다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로그인 토큰 서명 키. 비우면 프로세스마다 새로 생성되어 재시작 시 로그인이 풀린다.
SECRET_KEY=
